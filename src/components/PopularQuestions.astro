---
// "Popular questions": links from the home page to the most useful guide pages,
// in the page's language. Titles come from each page's own front matter.
import { getCollection } from "astro:content";
import { t as tFor, parseGuideId, guidePath } from "../i18n/index.js";

interface Props { lang: string }
const { lang } = Astro.props;
const t = tFor(lang);
const PICKS = [
  ["pay", "minimum-wage-2027"],
  ["pay", "24-hour-shifts"],
  ["pay", "wage-parity"],
  ["cdpap", "pay-rate"],
  ["cdpap", "not-paid/index"]
];
const pages = (await getCollection("guide")).map((p) => ({ ...parseGuideId(p.id), title: p.data.title }));
// Folder index pages may have ids ending in "/index" or not; compare without it.
const bare = (slug) => slug.replace(/\/index$/, "");
const items = PICKS.map(([section, slug]) => pages.find((p) => p.lang === lang && p.section === section && bare(p.slug) === bare(slug)))
  .filter(Boolean)
  .map((p) => ({ href: guidePath(lang, p.slug, p.section), title: p.title }));
---
{items.length > 0 && (
  <div class="wrap">
    <section class="card popular" aria-labelledby="popular-h">
      <h2 id="popular-h">{t("home.popular.h2")}</h2>
      <ul>
        {items.map((i) => <li><a href={i.href}>{i.title}</a></li>)}
      </ul>
    </section>
  </div>
)}
