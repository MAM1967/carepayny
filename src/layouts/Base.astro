---
import "@fontsource/atkinson-hyperlegible/400.css";
import "@fontsource/atkinson-hyperlegible/700.css";
// Headings font: weight axis only (41 KB) instead of weight + optical size (77 KB).
import "@fontsource-variable/bricolage-grotesque/wght.css";
import "../styles/global.css";
// Preload the body font so text doesn't jump when it loads (layout shift).
import bodyFont400 from "@fontsource/atkinson-hyperlegible/files/atkinson-hyperlegible-latin-400-normal.woff2?url";
import bodyFont700 from "@fontsource/atkinson-hyperlegible/files/atkinson-hyperlegible-latin-700-normal.woff2?url";
import { RULES } from "../data/rules.js";
import { LAUNCHED, CF_ANALYTICS_TOKEN, EMAIL_SIGNUP_OPEN } from "../data/site.js";
import { ORGANIZATION, WEBSITE, SITE_NAME, SITE_URL, pageTitle } from "../lib/seo.js";
import { CONTACT_EMAIL } from "../data/site.js";
import { LOCALES, DEFAULT_LOCALE, stripLocale, localizePath } from "../i18n/locales.js";
import { t as tFor, UI, alternatesFor, dateFor } from "../i18n/index.js";
import { fmt } from "../i18n/format.js";

interface Props {
  /** Set false to turn off visit counting on a page. */
  analytics?: boolean;
  title: string;
  description: string;
  lang?: string;
  ogType?: "website" | "article";
  modified?: string;          // ISO date, for articles
  jsonLd?: object[];          // extra structured data for this page
  noindex?: boolean;          // keep this page out of search results
}
const { title, description, lang = DEFAULT_LOCALE, ogType = "website", modified, jsonLd = [], analytics = true, noindex = false } = Astro.props;
const beacon = LAUNCHED && analytics && CF_ANALYTICS_TOKEN ? JSON.stringify({ token: CF_ANALYTICS_TOKEN }) : null;
const t = tFor(lang);
const L = LOCALES[lang];
const html = (key: string, vars = {}) => fmt(UI[lang]?.[key] ?? UI[DEFAULT_LOCALE][key], vars);
const basePath = stripLocale(Astro.url.pathname);
// About, Terms, Privacy and the training program list are English only; every other page may have translations.
const ENGLISH_ONLY = ["/about", "/terms", "/privacy", "/corrections", "/training/programs"];
const alternates = ENGLISH_ONLY.some((p) => basePath.startsWith(p)) ? [] : await alternatesFor(basePath);
const englishUrl = localizePath(DEFAULT_LOCALE, basePath);
const fullTitle = pageTitle(title);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/og.png", Astro.site).href;
const graph = { "@context": "https://schema.org", "@graph": [ORGANIZATION, WEBSITE, ...jsonLd] };
---
<!DOCTYPE html>
<html lang={L.htmlLang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  {(!LAUNCHED || noindex) && <meta name="robots" content="noindex, nofollow">}
  <link rel="canonical" href={canonical}>
  <link rel="preload" href={bodyFont400} as="font" type="font/woff2" crossorigin>
  <link rel="preload" href={bodyFont700} as="font" type="font/woff2" crossorigin>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="sitemap" href="/sitemap.xml">
  {alternates.length > 1 && alternates.map((a) => <link rel="alternate" hreflang={LOCALES[a.lang].hreflang} href={new URL(a.href, SITE_URL).href}>)}
  {alternates.length > 1 && <link rel="alternate" hreflang="x-default" href={new URL(englishUrl, SITE_URL).href}>}
  <meta property="og:site_name" content={SITE_NAME}>
  <meta property="og:type" content={ogType}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={t("meta.ogAlt")}>
  <meta property="og:locale" content={L.og}>
  {modified && <meta property="article:modified_time" content={modified}>}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#1d4ed8">
  <script type="application/ld+json" set:html={JSON.stringify(graph)} />
</head>
<body data-count={beacon ? "1" : undefined}>
  <a class="skip" href="#main">{t("nav.skip")}</a>
  <header class="site-header">
    <div class="inner">
      <a class="brand" href={localizePath(lang, "/")} aria-label={t("nav.home")}>
        <svg class="brand-mark" viewBox="0 0 64 64" aria-hidden="true" focusable="false"><rect width="64" height="64" rx="16"/><path class="heart" d="M32 51C32 51 12 39.5 12 25.5C12 18.5 17.5 14 23.5 14C27.3 14 30.4 16 32 19C33.6 16 36.7 14 40.5 14C46.5 14 52 18.5 52 25.5C52 39.5 32 51 32 51Z"/><path class="check" d="M23.5 31L29.5 37L41 25"/></svg>
        <span class="brand-name">CarePay<span>NY</span></span>
      </a>
      <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="site-nav">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
        {t("nav.menu")}
      </button>
      <nav class="site-nav" id="site-nav" aria-label={t("nav.main")}>
        <a href={localizePath(lang, "/")}>{t("nav.payCheck")}</a>
        <a href={localizePath(lang, "/pay/")}>{t("nav.payGuide")}</a>
        <a href={localizePath(lang, "/cdpap/")}>{t("nav.guide")}</a>
        <a href={localizePath(lang, "/training/")}>{t("nav.training")}</a>
        <a href="/about/" lang="en">{t("nav.about")}</a>
      </nav>
      {alternates.length > 1 && (
        <nav class="lang-switch" aria-label={t("nav.languages")}>
          {alternates.map((a) => (
            <a href={a.href} hreflang={LOCALES[a.lang].hreflang} lang={LOCALES[a.lang].htmlLang} aria-current={a.lang === lang ? "true" : undefined}>{LOCALES[a.lang].name}</a>
          ))}
        </nav>
      )}
    </div>
  </header>
  <main id="main">
    {lang !== DEFAULT_LOCALE && (
      <div class="wrap"><p class="translated-notice" set:html={html("notice.translated.html", { englishUrl, email: CONTACT_EMAIL })} /></div>
    )}
    <slot />
    {!noindex && (
      <div class="share-wrap">
        <button type="button" class="ghost share-btn" hidden data-copied={t("share.copied")}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M12 15V4M7.5 8.5 12 4l4.5 4.5M5 13v6h14v-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {t("share.button")}
        </button>
        <span class="small share-msg" role="status"></span>
      </div>
    )}
  </main>
  <footer class="wrap">
    <div class="disclaimer">
      <p set:html={html("footer.disclaimer.html", { date: dateFor(lang, RULES.lastReviewed) })} />
      <p>{t("footer.independent", { version: RULES.version })}</p>
      <p set:html={html("footer.legal.html")} />
      <p set:html={html("footer.rates.html", { ratesUrl: localizePath(lang, "/rates/") })} />
      {EMAIL_SIGNUP_OPEN && <p set:html={html("footer.updates.html", { updatesUrl: localizePath(lang, "/updates/") })} />}
    </div>
  </footer>
  {beacon && <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={beacon}></script>}
  <script>
    // Phones: fold the main menu behind a "Menu" button. Without JavaScript the menu just stays open.
    const header = document.querySelector(".site-header");
    const toggle = header?.querySelector(".menu-toggle");
    if (header && toggle) {
      header.classList.add("has-menu");
      toggle.addEventListener("click", () => {
        const open = header.classList.toggle("menu-open");
        toggle.setAttribute("aria-expanded", String(open));
      });
    }

    // "Share this page": the phone's share sheet (WhatsApp, texts...) or, if there is none, copy the link.
    // Shares only the page address. Nothing is counted or sent to us.
    const shareBtn = document.querySelector<HTMLButtonElement>(".share-btn");
    if (shareBtn && (navigator.share || navigator.clipboard)) {
      const msg = document.querySelector(".share-msg");
      const url = document.querySelector<HTMLLinkElement>('link[rel="canonical"]')?.href || location.href;
      shareBtn.hidden = false;
      shareBtn.addEventListener("click", async () => {
        if (navigator.share) {
          try { await navigator.share({ title: document.title, url }); } catch { /* closed the share sheet */ }
          return;
        }
        try {
          await navigator.clipboard.writeText(url);
          if (msg) msg.textContent = shareBtn.dataset.copied || "";
        } catch { /* copying blocked */ }
      });
    }
  </script>
  <script>
    // Anonymous page view with a yes/no "visited before" marker (src/lib/events.js).
    // Runs only when <body data-count="1"> (site launched and counting on for this page).
    import { sanitize, send, returningFlag } from "../lib/events.js";
    if (document.body.dataset.count === "1") {
      send(sanitize({ e: "view", lang: (document.documentElement.lang || "en").slice(0, 2), page: location.pathname, returning: returningFlag() }));
    }
  </script>
</body>
</html>
