---
import "@fontsource/atkinson-hyperlegible/400.css";
import "@fontsource/atkinson-hyperlegible/700.css";
import "@fontsource-variable/bricolage-grotesque/opsz.css";
import "../styles/global.css";
import { RULES } from "../data/rules.js";
import { LAUNCHED } from "../data/site.js";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const fullTitle = title === "CarePayNY" ? title : `${title} | CarePayNY`;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  {!LAUNCHED && <meta name="robots" content="noindex, nofollow">}
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="inner">
      <a class="brand" href="/" aria-label="CarePayNY home">
        <svg class="brand-mark" viewBox="0 0 64 64" aria-hidden="true" focusable="false"><rect width="64" height="64" rx="16"/><path class="heart" d="M32 51C32 51 12 39.5 12 25.5C12 18.5 17.5 14 23.5 14C27.3 14 30.4 16 32 19C33.6 16 36.7 14 40.5 14C46.5 14 52 18.5 52 25.5C52 39.5 32 51 32 51Z"/><path class="check" d="M23.5 31L29.5 37L41 25"/></svg>
        <span class="brand-name">CarePay<span>NY</span></span>
      </a>
      <nav class="site-nav" aria-label="Main">
        <a href="/">Pay check</a>
        <a href="/cdpap/">CDPAP guide</a>
        <a href="/about/">About</a>
      </nav>
    </div>
  </header>
  <main id="main">
    <slot />
  </main>
  <footer class="wrap">
    <div class="disclaimer">
      <p><strong>Estimates, not legal advice.</strong> CarePayNY explains New York's home care pay rules as of {RULES.lastReviewed} and can't account for every situation. Union contracts (such as 1199SEIU), shift differentials, holiday pay, paid time off and other benefits can change what you're owed. The New York State Department of Labor enforces the state's wage laws.</p>
      <p>We're independent and not affiliated with the New York State Department of Health, the Department of Labor, PPL or Medicaid. Rules version {RULES.version}.</p>
    </div>
  </footer>
</body>
</html>
