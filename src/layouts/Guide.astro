---
import Base from "./Base.astro";
import { getCollection } from "astro:content";
import { isoDate, SITE_URL } from "../lib/seo.js";
import { t as tFor, parseGuideId, guidePath } from "../i18n/index.js";
import { LOCALES, localizePath } from "../i18n/locales.js";

interface Props {
  lang: string;
  slug: string;
  data: { title: string; description: string; lastChecked: string; sources: { label: string; url: string }[] };
}
const { lang, slug, data } = Astro.props;
const { title, description, lastChecked, sources } = data;
const t = tFor(lang);
// lastChecked is always written in English ("November 11, 2026") so it parses in every language.
const modified = isoDate(lastChecked);
const shownDate = new Intl.DateTimeFormat(LOCALES[lang].intl, { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" }).format(new Date(modified + "T12:00:00Z"));
const url = `${SITE_URL}${guidePath(lang, slug)}`;
const jsonLd = [
  {
    "@type": "Article",
    "@id": `${url}#article`,
    headline: title,
    description,
    url,
    mainEntityOfPage: url,
    inLanguage: LOCALES[lang].hreflang,
    dateModified: modified,
    author: { "@id": `${SITE_URL}/#org` },
    publisher: { "@id": `${SITE_URL}/#org` },
    image: `${SITE_URL}/og.png`,
    isPartOf: { "@id": `${SITE_URL}/#website` },
    about: { "@type": "GovernmentService", name: "Consumer Directed Personal Assistance Program (CDPAP)", areaServed: "New York State" },
    citation: sources.map((s) => s.url)
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "CarePayNY", item: `${SITE_URL}${localizePath(lang, "/")}` },
      { "@type": "ListItem", position: 2, name: t("guide.name"), item: `${SITE_URL}${guidePath(lang, "index")}` },
      ...(slug === "index" ? [] : [{ "@type": "ListItem", position: 3, name: title, item: url }])
    ]
  }
];
const pages = (await getCollection("guide"))
  .map((p) => ({ ...parseGuideId(p.id), data: p.data }))
  .filter((p) => p.lang === lang)
  .sort((a, b) => a.data.order - b.data.order);
const isHub = (s: string) => s === "not-paid/index" || s === "not-paid";
const top = pages.filter((p) => !p.slug.startsWith("not-paid/") || isHub(p.slug));
const notPaid = pages.filter((p) => p.slug.startsWith("not-paid/") && !isHub(p.slug));
---
<Base lang={lang} title={title} description={description} ogType="article" modified={modified} jsonLd={jsonLd}>
  <div class="wrap guide">
    <nav class="crumbs" aria-label={t("guide.breadcrumb")}>
      <a href={guidePath(lang, "index")}>{t("guide.name")}</a>{slug !== "index" && <> › <span>{title}</span></>}
    </nav>
    <article class="prose">
      <h1>{title}</h1>
      <p class="checked">{t("guide.lastChecked")} <time datetime={modified}>{shownDate}</time></p>
      <slot />
      <h2>{t("guide.sources")}</h2>
      <ul class="sources">
        {sources.map((s) => <li><a href={s.url}>{s.label}</a></li>)}
      </ul>
      <p class="small">{t("guide.independent")}</p>
    </article>
    <nav class="guide-nav card" aria-label={t("guide.pages")}>
      <h2>{t("guide.name")}</h2>
      <ol>
        {top.map((p) => (
          <li>
            <a href={guidePath(lang, p.slug)} aria-current={p.slug === slug ? "page" : undefined}>{p.data.nav}</a>
            {isHub(p.slug) && (
              <ul>
                {notPaid.map((c) => <li><a href={guidePath(lang, c.slug)} aria-current={c.slug === slug ? "page" : undefined}>{c.data.nav}</a></li>)}
              </ul>
            )}
          </li>
        ))}
      </ol>
    </nav>
  </div>
</Base>
