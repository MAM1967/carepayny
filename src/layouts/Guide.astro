---
import Base from "./Base.astro";
import { getCollection } from "astro:content";
import { isoDate, SITE_URL, guideHref } from "../lib/seo.js";

interface Props {
  title: string;
  description: string;
  lastChecked: string;
  sources: { label: string; url: string }[];
  slug: string;
}
const { title, description, lastChecked, sources, slug } = Astro.props;
const modified = isoDate(lastChecked);
const url = `${SITE_URL}${guideHref(slug)}`;
const jsonLd = [
  {
    "@type": "Article",
    "@id": `${url}#article`,
    headline: title,
    description,
    url,
    mainEntityOfPage: url,
    inLanguage: "en-US",
    dateModified: modified,
    author: { "@id": `${SITE_URL}/#org` },
    publisher: { "@id": `${SITE_URL}/#org` },
    image: `${SITE_URL}/og.png`,
    isPartOf: { "@id": `${SITE_URL}/#website` },
    about: { "@type": "GovernmentService", name: "Consumer Directed Personal Assistance Program (CDPAP)", areaServed: "New York State" },
    citation: sources.map((s) => s.url)
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "CarePayNY", item: `${SITE_URL}/` },
      { "@type": "ListItem", position: 2, name: "CDPAP guide", item: `${SITE_URL}/cdpap/` },
      ...(slug === "index" ? [] : [{ "@type": "ListItem", position: 3, name: title, item: url }])
    ]
  }
];
const pages = (await getCollection("guide")).sort((a, b) => a.data.order - b.data.order);
const href = guideHref;
const top = pages.filter((p) => !p.id.startsWith("not-paid/") || p.id === "not-paid/index" || p.id === "not-paid");
const notPaid = pages.filter((p) => p.id.startsWith("not-paid/") && p.id !== "not-paid/index");
---
<Base title={title} description={description} ogType="article" modified={modified} jsonLd={jsonLd}>
  <div class="wrap guide">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/cdpap/">CDPAP guide</a>{slug !== "index" && <> › <span>{title}</span></>}
    </nav>
    <article class="prose">
      <h1>{title}</h1>
      <p class="checked">Last checked: <time datetime={modified}>{lastChecked}</time></p>
      <slot />
      <h2>Sources</h2>
      <ul class="sources">
        {sources.map((s) => <li><a href={s.url}>{s.label}</a></li>)}
      </ul>
      <p class="small">CarePayNY is independent. We are not part of PPL, the New York State Department of Health, the Department of Labor or Medicaid. This page gives general information, not legal advice.</p>
    </article>
    <nav class="guide-nav card" aria-label="CDPAP guide pages">
      <h2>CDPAP guide</h2>
      <ol>
        {top.map((p) => (
          <li>
            <a href={href(p.id)} aria-current={p.id === slug ? "page" : undefined}>{p.data.nav}</a>
            {(p.id === "not-paid/index" || p.id === "not-paid") && (
              <ul>
                {notPaid.map((c) => <li><a href={href(c.id)} aria-current={c.id === slug ? "page" : undefined}>{c.data.nav}</a></li>)}
              </ul>
            )}
          </li>
        ))}
      </ol>
    </nav>
  </div>
</Base>
