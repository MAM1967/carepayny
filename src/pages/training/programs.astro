---
// /training/programs/: every home care aide training program on the NYS Department of Health's
// approved list, read from src/data/training-programs.js (built by scripts/training-programs.py).
// English only for now. Order is neutral (area, then A to Z) and never depends on payment.
// Outbound map and website links go through /go/<id> (functions/go/[id].js), which only redirects;
// phone taps are counted with the same anonymous "out" event (src/lib/events.js).
import Base from "../../layouts/Base.astro";
import DATA from "../../data/training-programs.js";
import { SITE_URL, isoDate } from "../../lib/seo.js";

// Set by scripts/training-programs.py each time the list is rebuilt from DOH's file.
const LAST_CHECKED = DATA.lastChecked;
const modified = isoDate(LAST_CHECKED);
const reportDate = new Date(DATA.reportDate + "T12:00:00Z");
const fmtDate = (d: Date) => new Intl.DateTimeFormat("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" }).format(d);
const shownReport = fmtDate(reportDate);
const shownChecked = fmtDate(new Date(modified + "T12:00:00Z"));

const programs = DATA.programs;
const BOROUGHS = ["Bronx", "Brooklyn", "Manhattan", "Queens", "Staten Island"];
const count = (area: string) => programs.filter((p) => p.area === area).length;
const nycCount = programs.filter((p) => p.region === "New York City").length;
const countyCount = new Set(programs.map((p) => p.county)).size;
// Statewide, by the state's 10 economic development regions (Empire State Development).
// Within a region: boroughs or counties A to Z, then programs A to Z. Never ordered by payment.
const regions = DATA.regions
  .map((region) => {
    const list = programs.filter((p) => p.region === region);
    const areas = [...new Set(list.map((p) => p.area))].sort().map((area) => ({ area, list: list.filter((p) => p.area === area) }));
    return { region, slug: region.toLowerCase().replace(/\W+/g, "-"), count: list.length, areas };
  })
  .filter((r) => r.count);

const LANG_NAME: Record<string, string> = { en: "English", es: "Spanish", zh: "Chinese", ru: "Russian", ko: "Korean" };
const telHref = (phone: string) => "tel:+1" + phone.replace(/\D/g, "").slice(-10);
const areaLabel = (a: string) => (BOROUGHS.includes(a) ? a : `${a} County`);

const title = "Approved home care aide training programs in New York";
const description = `A list of the ${programs.length} home health aide (HHA) and personal care aide (PCA) training programs on the NYS Department of Health's approved list, by borough and county, with languages and phone numbers.`;
const url = `${SITE_URL}/training/programs/`;
const sources = [
  { label: `NYS Department of Health: Approved PCA and HHA training programs (list dated ${shownReport})`, url: DATA.source },
  { label: "NYS Department of Health: Home care worker training and certification", url: "https://www.health.ny.gov/facilities/home_care/professional.htm" },
  { label: "NYS Department of Health: Hybrid training approval for PCA and HHA training programs (DAL DHCBS 20-09)", url: "https://www.health.ny.gov/facilities/home_care/dal/docs/20-09.pdf" },
  { label: "NYS Department of Health: Guide to operating a home health aide training program (August 2021)", url: "https://health.ny.gov/professionals/home_care/docs/hhatp_guide.pdf" },
  { label: "NYS Department of Health: Guide to operating a personal care aide training program (May 2022)", url: "https://health.ny.gov/professionals/home_care/guide_to_operate_pcatp/docs/guide.pdf" }
];
const jsonLd = [
  {
    "@type": "CollectionPage",
    "@id": `${url}#page`,
    name: title,
    description,
    url,
    inLanguage: "en-US",
    dateModified: modified,
    publisher: { "@id": `${SITE_URL}/#org` },
    isPartOf: { "@id": `${SITE_URL}/#website` },
    citation: sources.map((s) => s.url)
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${url}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "CarePayNY", item: `${SITE_URL}/` },
      { "@type": "ListItem", position: 2, name: "Training and requirements", item: `${SITE_URL}/training/` },
      { "@type": "ListItem", position: 3, name: "Approved training programs", item: url }
    ]
  }
];
---
<Base title={title} description={description} ogType="article" modified={modified} jsonLd={jsonLd}>
  <div class="wrap guide">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">CarePayNY</a> › <a href="/training/">Training and requirements</a> › <span aria-current="page">Approved training programs</span>
    </nav>
    <article class="prose programs-page">
      <h1>{title}</h1>
      <p class="checked">Last checked <time datetime={modified}>{shownChecked}</time></p>

      <p>This page lists the home care agencies and hospices whose aide training programs are approved by the New York State Department of Health. The list comes from the Department of Health's list dated <strong>{shownReport}</strong>. It covers all of New York State: {programs.length} places in {countyCount} counties, from New York City ({nycCount}) to Long Island, the Hudson Valley, the Capital Region, Central and Western New York, the Southern Tier and the North Country.</p>
      <p>Approval can change. The Department of Health updates its list from time to time. The <a href={DATA.source}>Department of Health's list</a> is the one that counts.</p>

      <h2>What the labels mean</h2>
      <ul>
        <li><strong>HHA</strong>: a home health aide training program, at least 75 hours.</li>
        <li><strong>PCA</strong>: a personal care aide training program, at least 40 hours.</li>
        <li><strong>Part online</strong>: the Department of Health approved a <strong>hybrid</strong> program, which means part of the class is online and part is in person.</li>
        <li><strong>Languages</strong>: next to each training, the languages it is approved to teach in. Each class is taught in one language.</li>
      </ul>
      <p>More about the two trainings, the skills test and the Home Care Registry: <a href="/training/">How to become a home care aide in New York</a>.</p>

      <h2>What does training cost?</h2>
      <ul>
        <li>A personal care aide program approved by the Department of Health may not charge any fee or tuition.</li>
        <li>A home health aide program approved by the Department of Health may charge up to $100, for things the trainee keeps.</li>
        <li>Some agencies train people for free and plan to hire them after. Whether a program comes with a work agreement is something each program can explain.</li>
      </ul>

      <h2>How this list works</h2>
      <p>Programs are listed by region and county, then from A to Z. Being on this list is free. If a program ever pays for a featured spot, it will be labeled "Sponsored." CarePayNY is not part of the Department of Health, and a listing here is not a review or a promise of a job.</p>
    </article>

    <section class="card programs" aria-labelledby="find-heading">
      <h2 id="find-heading">Find a program</h2>
      <form class="program-filters row" id="program-filters" hidden>
        <label class="field">Area
          <select id="f-area">
            <option value="all">All of New York State ({programs.length})</option>
            {regions.map((r) => (
              <optgroup label={r.region}>
                <option value={`r:${r.slug}`}>{r.region === "New York City" ? "All of New York City" : `All of ${r.region}`} ({r.count})</option>
                {r.areas.map(({ area }) => <option value={area}>{areaLabel(area)} ({count(area)})</option>)}
              </optgroup>
            ))}
          </select>
        </label>
        <label class="field">Training
          <select id="f-type">
            <option value="">HHA or PCA</option>
            <option value="hha">Home health aide (HHA)</option>
            <option value="pca">Personal care aide (PCA)</option>
          </select>
        </label>
        <label class="field">Language
          <select id="f-lang">
            <option value="">Any language</option>
            {Object.entries(LANG_NAME).map(([code, name]) => <option value={code}>{name}</option>)}
          </select>
        </label>
        <label class="check"><input type="checkbox" id="f-hybrid"> <span>Part online only</span></label>
      </form>
      <p class="small" id="program-count" aria-live="polite">{programs.length} programs in New York State.</p>

      {regions.map((r) => (
        <div class="program-region" data-region={r.slug}>
          <h3 class="region-name">{r.region}</h3>
          {r.areas.map(({ area, list }) => (
        <div class="program-area" data-area={area} data-region={r.slug}>
          <h4>{areaLabel(area)}</h4>
          <ul class="program-list">
            {list.map((p) => (
              <li class="program" data-id={p.id} data-hha={p.hha ? p.hhaLangs.join(" ") : ""} data-pca={p.pca ? p.pcaLangs.join(" ") : ""} data-hybrid={p.hybrid.join(" ")}>
                <strong class="program-name">{p.name}</strong>
                <span class="program-addr">{p.address}, {p.city}, NY {p.zip}</span>
                {p.hha && <span class="program-tags"><span class="badge">HHA{p.hybrid.includes("HHA") ? ", part online" : ""}</span><span class="program-langs">{p.hhaLangs.map((l) => LANG_NAME[l]).join(", ")}</span></span>}
                {p.pca && <span class="program-tags"><span class="badge">PCA{p.hybrid.includes("PCA") ? ", part online" : ""}</span><span class="program-langs">{p.pcaLangs.map((l) => LANG_NAME[l]).join(", ")}</span></span>}
                <span class="program-links">
                  <a href={telHref(p.phone)} data-out="tel">{p.phone}</a>
                  <a href={`/go/${p.id}?to=map`} data-out="map" rel="nofollow noopener" target="_blank">Map</a>
                  {p.url && <a href={`/go/${p.id}?to=web`} data-out="web" rel="nofollow noopener" target="_blank">Website</a>}
                </span>
              </li>
            ))}
          </ul>
        </div>
          ))}
        </div>
      ))}
      <p class="small" id="program-empty" hidden>No program on the list matches these choices. Fewer choices show more programs.</p>
    </section>

    <section class="prose">
      <h2>Sources</h2>
      <ul class="sources">
        {sources.map((s) => <li><a href={s.url}>{s.label}</a></li>)}
      </ul>
      <p class="small">CarePayNY is independent. It is not part of, or approved by, the NYS Department of Health or any training program.</p>
    </section>
  </div>
</Base>

<style is:global>
  /* Global (not scoped) so the 750+ list items don't each get an extra attribute. */
  .programs h2 { font: 600 1.3rem/1.3 var(--font-display); margin: 0 0 12px; }
  .program-filters { margin-bottom: 8px; align-items: end; }
  .program-filters select { width: 100%; font: inherit; padding: 9px 10px; border: 1.5px solid var(--line); border-radius: 10px; background: var(--paper); color: var(--ink); }
  .program-filters .check { align-self: center; }
  .program[hidden], .program-area[hidden], .program-region[hidden] { display: none; }
  .program-region .region-name { font: 700 1.2rem/1.3 var(--font-display); margin: 24px 0 4px; padding-top: 12px; border-top: 1px solid var(--line); }
  .program-area h4 { font: 600 1.05rem/1.3 var(--font-display); margin: 14px 0 8px; }
  .program-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
  .program { border: 1px solid var(--line); border-radius: 10px; padding: 12px; display: grid; gap: 4px; }
  .program .badge { margin: 0 6px 0 0; }
  .program-addr, .program-langs { color: var(--muted); font-size: .92rem; }
  .program-links { display: flex; gap: 14px; flex-wrap: wrap; font-weight: 700; margin-top: 4px; }
</style>

<script>
  // Filters (the full list shows without JavaScript) and anonymous link counting.
  import { sanitize, send } from "../../lib/events.js";

  const form = document.getElementById("program-filters") as HTMLFormElement;
  const area = document.getElementById("f-area") as HTMLSelectElement;
  const type = document.getElementById("f-type") as HTMLSelectElement;
  const lang = document.getElementById("f-lang") as HTMLSelectElement;
  const hybrid = document.getElementById("f-hybrid") as HTMLInputElement;
  const countEl = document.getElementById("program-count")!;
  const empty = document.getElementById("program-empty")!;
  const groups = [...document.querySelectorAll<HTMLElement>(".program-area")];
  const regionEls = [...document.querySelectorAll<HTMLElement>(".program-region")];

  function apply() {
    let shown = 0;
    for (const g of groups) {
      const a = area.value;
      const inArea = a === "all" || (a.startsWith("r:") ? g.dataset.region === a.slice(2) : g.dataset.area === a);
      let n = 0;
      for (const li of g.querySelectorAll<HTMLElement>(".program")) {
        // A place matches if one of its trainings (HHA or PCA) fits every choice at once.
        const kinds = type.value ? [type.value] : ["hha", "pca"];
        const ok = inArea && kinds.some((k) => {
          const langs = li.dataset[k] || "";
          if (!langs) return false;
          if (lang.value && !langs.split(" ").includes(lang.value)) return false;
          if (hybrid.checked && !(li.dataset.hybrid || "").split(" ").includes(k.toUpperCase())) return false;
          return true;
        });
        li.hidden = !ok;
        if (ok) n++;
      }
      g.hidden = n === 0;
      shown += n;
    }
    for (const r of regionEls) r.hidden = !r.querySelector(".program-area:not([hidden])");
    const where = area.options[area.selectedIndex].text.replace(/\s*\(\d+\)$/, "");
    countEl.textContent = `${shown} ${shown === 1 ? "program" : "programs"} shown: ${where}.`;
    empty.hidden = shown !== 0;
  }

  form.hidden = false;
  form.addEventListener("change", apply);
  form.addEventListener("submit", (e) => e.preventDefault());
  apply();

  // Every tap on a phone, map or website link is counted here, in the browser. Scrapers read
  // links without tapping them, so counting on tap keeps the totals to real people. (Counting
  // on the server at /go/ counted a scraper's 293 fake "map" clicks on Nov 20-21, 2026.)
  const counted = (e: Event) => {
    const a = (e.target as Element).closest<HTMLAnchorElement>("a[data-out]");
    const li = a?.closest<HTMLElement>(".program");
    if (a && li && document.body.dataset.count === "1") {
      send(sanitize({ e: "out", lang: "en", prog: li.dataset.id, kind: a.dataset.out }));
    }
  };
  document.addEventListener("click", counted);
  // A middle click (open in a new tab) fires "auxclick", not "click".
  document.addEventListener("auxclick", (e) => { if ((e as MouseEvent).button === 1) counted(e); });
</script>
