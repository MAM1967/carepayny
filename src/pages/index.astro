---
import Base from "../layouts/Base.astro";
import { RULES } from "../data/rules.js";
---
<Base title="Am I being paid right? NY home care pay check" description="Free calculator for New York home care aides, home health aides and CDPAP caregivers. Check your pay against 2026 minimum wage, wage parity, overtime and 24-hour shift rules. Nothing you enter is saved.">
<div class="wrap">
<header>
    <span class="badge" id="rulesBadge">2026 New York rules</span>
    <h1>Am I being paid right?</h1>
    <p>For home care aides, home health aides and CDPAP caregivers in New York. Answer a few questions about one week of work and see what the law says you should be paid. Nothing you type is saved or sent anywhere.</p>
  </header>

  <div class="grid">
    <form class="card" id="f" novalidate>
      <fieldset>
        <legend>1. Where do you work?</legend>
        <div class="choices" role="radiogroup" aria-label="Region">
          <input type="radio" name="region" id="r-nyc" value="nyc" checked><label for="r-nyc">New York City</label>
          <input type="radio" name="region" id="r-liw" value="liw"><label for="r-liw">Nassau, Suffolk or Westchester</label>
          <input type="radio" name="region" id="r-rest" value="rest"><label for="r-rest">Rest of New York</label>
        </div>
      </fieldset>

      <fieldset>
        <legend>2. Who pays you?</legend>
        <div class="choices" role="radiogroup" aria-label="Employer">
          <input type="radio" name="employer" id="e-agency" value="agency" checked><label for="e-agency">A home care agency</label>
          <input type="radio" name="employer" id="e-cdpap" value="cdpap"><label for="e-cdpap">CDPAP (paid through PPL)</label>
          <input type="radio" name="employer" id="e-private" value="private"><label for="e-private">A family hires me directly</label>
        </div>
        <div id="medicaidBox" class="field">
          <label class="q" id="medicaidLabel">Does Medicaid pay for your client's care?</label>
          <div class="choices" role="radiogroup" aria-labelledby="medicaidLabel">
            <input type="radio" name="medicaid" id="m-yes" value="yes" checked><label for="m-yes">Yes</label>
            <input type="radio" name="medicaid" id="m-no" value="no"><label for="m-no">No, they pay privately</label>
            <input type="radio" name="medicaid" id="m-unsure" value="unsure"><label for="m-unsure">Not sure</label>
          </div>
          <p class="hint">Most agency cases in NYC are Medicaid, often through a managed long-term care plan.</p>
        </div>
      </fieldset>

      <fieldset>
        <legend>3. Your pay and hours this week</legend>
        <div class="row">
          <div class="field">
            <label class="q" for="rate">Hourly rate</label>
            <div class="money"><span>$</span><input type="number" id="rate" inputmode="decimal" min="0" step="0.01" value="20.00"></div>
          </div>
          <div class="field">
            <label class="q" for="regularHours">Regular hours</label>
            <input type="number" id="regularHours" inputmode="decimal" min="0" step="0.25" value="40">
            <p class="hint">Not counting 24-hour shifts</p>
          </div>
        </div>
      </fieldset>

      <fieldset>
        <legend>4. 24-hour shifts</legend>
        <div class="field">
          <label class="q" for="shifts24">How many 24-hour shifts did you work this week?</label>
          <input type="number" id="shifts24" inputmode="numeric" min="0" max="7" step="1" value="0">
        </div>
        <div id="liveInBox" class="row hidden">
          <div class="field">
            <label class="q" for="sleepMissed">Shifts where you did NOT get 8 hours for sleep, with 5 in a row</label>
            <input type="number" id="sleepMissed" inputmode="numeric" min="0" max="7" step="1" value="0">
          </div>
          <div class="field">
            <label class="q" for="mealsMissed">Shifts where you did NOT get 3 hours of meal breaks</label>
            <input type="number" id="mealsMissed" inputmode="numeric" min="0" max="7" step="1" value="0">
          </div>
        </div>
        <div class="check" id="livesInBox">
          <input type="checkbox" id="livesIn"><label for="livesIn">I live in my client's home (it's where I sleep most nights)</label>
        </div>
      </fieldset>

      <fieldset>
        <legend>5. Check your pay stub (optional)</legend>
        <div class="field">
          <label class="q" for="stubGross">Gross pay on your stub for this week</label>
          <div class="money"><span>$</span><input type="number" id="stubGross" inputmode="decimal" min="0" step="0.01" placeholder="Before taxes"></div>
          <p class="hint">Use the total before taxes and deductions, for the same week as the hours above.</p>
        </div>
      </fieldset>
    </form>

    <aside class="card stub" id="results" aria-live="polite">
      <h2>What you should be paid</h2>
      <div id="status" class="status"></div>
      <table id="lines"></table>
      <ul class="flags" id="flags"></ul>
      <div class="actions">
        <button type="button" id="copyBtn">Copy summary</button>
        <button type="button" class="ghost" id="resetBtn">Start over</button>
      </div>
      <p class="small" id="copyMsg" role="status"></p>
    </aside>
  </div>

  <section class="info">
    <div class="card">
      <h3>If something looks wrong</h3>
      <ul>
        <li>Ask your agency's payroll office for your pay notice and your Wage Parity notice. You have a right to both.</li>
        <li>CDPAP caregivers: check your timesheets in your PPL account at <a href="https://pplfirst.com/">pplfirst.com</a>.</li>
        <li>Free legal help: <a href="https://legalaidnyc.org/">The Legal Aid Society</a> helps home care workers with unpaid wages.</li>
        <li>The <a href="https://dol.ny.gov/">New York State Department of Labor</a> takes wage claims. It's free to file a wage claim.</li>
      </ul>
    </div>
    <div class="card">
      <h3>The 2026 rules this uses</h3>
      <ul id="rulesList"></ul>
      <p class="small">Some state pages still show the older wage parity benefit of $4.09 (NYC) and $3.22 (Long Island and Westchester). The 2023 state budget lowered those to $2.54 and $1.67 from 2024 as the base wage rose, so total pay per hour went up. This tool uses the current amounts.</p>
    </div>
  </section>
  <section class="card">
    <h3>Sources</h3>
    <ul>
      {RULES.sources.map((s) => <li><a href={s.url}>{s.label}</a></li>)}
    </ul>
  </section>
</div>
<div class="result-bar" id="resultBar" data-status="ok">
  <div class="result-bar-text">
    <strong id="barHeadline">Looks right</strong>
    <span id="barAmount"></span>
  </div>
  <a class="result-bar-link" href="#results">See details</a>
</div>
</Base>

<script>
import { computeWeek } from "../lib/calc.js";
import { RULES } from "../data/rules.js";

const $ = id => document.getElementById(id);
const money = n => "$" + n.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const val = name => document.querySelector(`input[name="${name}"]:checked`).value;
const num = id => { const v = parseFloat($(id).value); return isNaN(v) ? 0 : v; };
let lastSummary = "";

function render() {
  const employer = val("employer");
  $("medicaidBox").classList.toggle("hidden", employer !== "agency");
  const shifts = Math.max(0, Math.floor(num("shifts24")));
  $("liveInBox").classList.toggle("hidden", shifts === 0);
  const stubRaw = $("stubGross").value.trim();

  const r = computeWeek({
    region: val("region"), employer, medicaid: val("medicaid"),
    rate: num("rate"), regularHours: num("regularHours"),
    shifts24: shifts, sleepMissed: Math.floor(num("sleepMissed")), mealsMissed: Math.floor(num("mealsMissed")),
    livesIn: $("livesIn").checked, stubGross: stubRaw === "" ? null : parseFloat(stubRaw)
  });

  const st = $("status");
  st.className = "status " + r.status;
  const headline = { ok: "Looks right", check: "Worth checking", bad: "You may be underpaid" }[r.status];
  const sub = {
    ok: "Based on what you entered, your pay meets New York's minimums.",
    check: "Your hourly rate is legal, but check the items below.",
    bad: "Based on what you entered, you may be owed more. See below."
  }[r.status];
  st.innerHTML = `<strong>${headline}</strong><span>${sub}</span>`;
  $("resultBar").dataset.status = r.status;
  $("barHeadline").textContent = headline;
  $("barAmount").textContent = `You should get ${money(r.expectedGross)} this week`;

  const rows = [
    ["Minimum hourly wage for you", money(r.minRate)],
    ...(r.pplRate != null ? [["PPL's base pay for CDPAP here", money(r.pplRate)]] : []),
    ["Hours you must be paid for", r.totalHours.toLocaleString() + " hrs"],
  ];
  if (r.liveInHours) rows.push(["…of which from 24-hour shifts", r.liveInHours + " hrs"]);
  rows.push([`Overtime hours (after ${r.threshold}) at 1.5×`, r.otHours.toLocaleString() + " hrs"]);
  if (r.wp) {
    rows.push([`Wage parity: total pay + benefits per hour${r.wp.applies === "maybe" ? " (if Medicaid)" : ""}`, money(r.wp.total)]);
    rows.push(["Benefits or extra cash owed on top of your rate", r.wp.coveredInCash ? "Covered by your rate" : money(r.wp.gapPerHour) + "/hr · " + money(r.wp.gapWeek) + " this week"]);
  }
  if (r.stub) rows.push(["Your pay stub shows", money(r.stub.entered)]);
  rows.push(["Gross pay you should get this week", money(r.expectedGross)]);
  $("lines").innerHTML = rows.map((x, i) => `<tr class="${i === rows.length - 1 ? "total" : ""}"><td>${x[0]}</td><td class="v">${x[1]}</td></tr>`).join("");

  const flags = [...r.flags];
  if (r.wp && !r.wp.coveredInCash) {
    flags.push({ level: "warn", text: `Because ${r.wp.applies === "yes" ? "your work is Medicaid-funded" : "your work may be Medicaid-funded"} in ${r.regionLabel}, your employer must give you at least ${money(r.wp.total)} an hour in total pay and benefits. With your rate, that's ${money(r.wp.gapPerHour)} an hour in benefits (like health insurance or paid time off) or extra cash. Your Wage Parity notice should show how they meet it.` });
  }
  $("flags").innerHTML = flags.map(f => `<li class="${f.level}">${f.text}</li>`).join("");

  lastSummary = [
    `Home care pay check (NY rules ${RULES.version})`,
    `Status: ${headline}`,
    ...rows.map(x => `${x[0]}: ${x[1]}`),
    ...flags.map(f => "- " + f.text),
    "Estimate only, not legal advice."
  ].join("\n");
}

function initStatic() {
  $("rulesBadge").textContent = `Rules in effect since ${RULES.effective}`;
  const R = RULES.regions;
  $("rulesList").innerHTML = [
    `Home care aide minimum wage: ${money(R.nyc.hcaMin)}/hr in NYC, Long Island and Westchester; ${money(R.rest.hcaMin)}/hr elsewhere.`,
    `Wage parity (Medicaid work): at least ${money(R.nyc.wpTotal)}/hr total in NYC (${money(R.nyc.wpBenefit)} benefit) and ${money(R.liw.wpTotal)}/hr in Nassau, Suffolk and Westchester (${money(R.liw.wpBenefit)} benefit).`,
    `24-hour shifts: may be paid as 13 hours only with 8 hours for sleep (5 uninterrupted) and 3 hours for meals. Otherwise those hours must be paid.`,
    `Overtime: 1.5× your rate after 40 hours a week (44 if a family employs you directly and you live in their home).`
  ].map(x => `<li>${x}</li>`).join("");
}

$("f").addEventListener("input", render);
$("f").addEventListener("change", render);
$("f").addEventListener("submit", e => e.preventDefault());
$("copyBtn").addEventListener("click", async () => {
  try { await navigator.clipboard.writeText(lastSummary); $("copyMsg").textContent = "Copied."; }
  catch { $("copyMsg").textContent = "Your browser blocked copying. Select the numbers above and copy them by hand."; }
});
$("resetBtn").addEventListener("click", () => { $("f").reset(); $("copyMsg").textContent = ""; render(); });

initStatic();

// Phones: hide the pinned result bar while the full results are on screen.
const bar = $("resultBar");
if ("IntersectionObserver" in window) {
  new IntersectionObserver(([entry]) => {
    bar.classList.toggle("is-hidden", entry.isIntersecting);
  }, { threshold: 0.15 }).observe($("results"));
}
render();
</script>
